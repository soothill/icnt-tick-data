KRAKEN_PAIR=ICNT/USD
KRAKEN_REST_PAIR=ICNTUSD
CACHE_DB_PATH=/data/ticks.sqlite

INFLUX_URL=http://influxdb:8086
INFLUX_ORG=your-org
INFLUX_BUCKET=icnt_ticks
INFLUX_TOKEN=replace-with-token

DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change-me
DOCKER_INFLUXDB_INIT_ORG=your-org
DOCKER_INFLUXDB_INIT_BUCKET=icnt_ticks
DOCKER_INFLUXDB_INIT_RETENTION=0
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=replace-with-token

FLUSH_INTERVAL_SEC=5
BACKFILL_INTERVAL_SEC=300
AGGREGATE_INTERVAL_SEC=30
BATCH_SIZE=5000
