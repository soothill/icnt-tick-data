[Unit]
Description=ICNT tick data pipeline (Kraken to InfluxDB)
Wants=influxdb.service
After=influxdb.service

[Container]
Image=localhost/icnt-tick-data:latest
ContainerName=icnt-tick-data
UserNS=keep-id
User=%U
EnvironmentFile=%h/.config/icnt-tick-data/icnt-tick-data.env
Volume=%h/.local/share/icnt-tick-data:/data:Z
Network=icnt-tick-data

[Service]
Restart=always
