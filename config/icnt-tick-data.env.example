KRAKEN_PAIR=ICNT/USD
KRAKEN_REST_PAIR=ICNTUSD
CACHE_DB_PATH=/data/ticks.sqlite

# InfluxDB URL:
# - If InfluxDB is on the same host (common when running an InfluxDB container with port 8086 published), use:
#     http://localhost:8086
# - For a remote InfluxDB over Tailscale, prefer a stable Tailscale IP to avoid DNS issues in containers:
#     http://100.x.y.z:8086
# - If you use MagicDNS/FQDN, ensure the container can resolve it (or use a Tailscale IP instead):
#     http://influxdb.<tailnet>.ts.net:8086
INFLUX_URL=http://localhost:8086
INFLUX_ORG=your-org
INFLUX_BUCKET=icnt_ticks
INFLUX_TOKEN=replace-with-token

# If you use Tailscale MagicDNS for INFLUX_URL (e.g. http://influxdb:8086 or http://influxdb.<tailnet>.ts.net:8086),
# the hostname may not resolve during early boot. The Quadlet unit will wait up to 90s by default.
# Override here if needed:
# TAILSCALE_DNS_WAIT_SEC=90

FLUSH_INTERVAL_SEC=5
BACKFILL_INTERVAL_SEC=300
AGGREGATE_INTERVAL_SEC=30
BATCH_SIZE=5000
